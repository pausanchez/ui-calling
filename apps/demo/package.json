{
  "name": "@ui-calling/demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch -C ui-calling-source --env-file-if-exists=../../.env server/index.ts\" \"vite\"",
    "dev:whatsapp": "tsx -C ui-calling-source --env-file-if-exists=../../.env server/tunnel.ts",
    "build": "vite build",
    "smoke": "tsx -C ui-calling-source server/smoke.ts",
    "start": "NODE_ENV=production PUBLIC_URL=${PUBLIC_URL:-http://localhost:8787} tsx -C ui-calling-source --env-file-if-exists=../../.env server/index.ts",
    "ui-calling": "ui-calling"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@hono/node-server": "^2.1.11",
    "@ui-calling/anthropic": "*",
    "@ui-calling/core": "*",
    "@ui-calling/react": "*",
    "@ui-calling/server": "*",
    "@ui-calling/sqlite": "*",
    "hono": "^4.13.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ui-calling": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
