{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["ui-calling-source"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "packages/*/src",
    "packages/cli/registry",
    "packages/cli/templates/surface",
    "packages/cli/templates/steps",
    "packages/cli/templates/init/store.postgres.ts",
    "scripts",
    "apps/demo/server",
    "apps/demo/src"
  ]
}
