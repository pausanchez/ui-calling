{
  "name": "@ui-calling/mcp",
  "version": "0.1.0-preview.0",
  "description": "Expose ui-calling surfaces as tools on an MCP server, so any MCP client can open screens.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pausanchez/ui-calling.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/pausanchez/ui-calling#readme",
  "bugs": {
    "url": "https://github.com/pausanchez/ui-calling/issues"
  },
  "keywords": [
    "ui-calling",
    "mcp",
    "model-context-protocol"
  ],
  "type": "module",
  "exports": {
    ".": {
      "ui-calling-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "tsup": {
    "entry": {
      "index": "src/index.ts"
    },
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true,
    "sourcemap": true,
    "target": "es2022",
    "removeNodeProtocol": false
  },
  "dependencies": {
    "@ui-calling/core": "^0.1.0-preview.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.20.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
