{
  "name": "@ui-calling/sqlite",
  "version": "0.0.1",
  "description": "Zero-config persistence for UI_calling sessions and events, on Node's built-in SQLite (node:sqlite). No dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pausanchez/ui_calling.git",
    "directory": "packages/sqlite"
  },
  "homepage": "https://github.com/pausanchez/ui_calling#readme",
  "bugs": {
    "url": "https://github.com/pausanchez/ui_calling/issues"
  },
  "keywords": [
    "ui-calling",
    "sqlite",
    "node:sqlite"
  ],
  "type": "module",
  "exports": {
    ".": {
      "ui-calling-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "tsup": {
    "entry": {
      "index": "src/index.ts"
    },
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true,
    "sourcemap": true,
    "target": "es2022",
    "platform": "node",
    "removeNodeProtocol": false
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@ui-calling/core": "^0.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
