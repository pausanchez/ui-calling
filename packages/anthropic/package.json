{
  "name": "@ui-calling/anthropic",
  "version": "0.1.0-preview.0",
  "description": "Use ui-calling surfaces as tools with the Anthropic SDK (tool runner or manual loop).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pausanchez/ui-calling.git",
    "directory": "packages/anthropic"
  },
  "homepage": "https://github.com/pausanchez/ui-calling#readme",
  "bugs": {
    "url": "https://github.com/pausanchez/ui-calling/issues"
  },
  "keywords": [
    "ui-calling",
    "anthropic",
    "claude",
    "tools"
  ],
  "type": "module",
  "exports": {
    ".": {
      "ui-calling-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "tsup": {
    "entry": {
      "index": "src/index.ts"
    },
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true,
    "sourcemap": true,
    "target": "es2022",
    "removeNodeProtocol": false
  },
  "dependencies": {
    "@ui-calling/core": "^0.1.0-preview.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.13.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
