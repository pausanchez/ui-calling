{
  "name": "@ui-calling/server",
  "version": "0.0.1",
  "description": "HTTP routes that serve UI_calling surfaces and collect their events (Hono, runs on Node, Bun, Workers).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pausanchez/ui_calling.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/pausanchez/ui_calling#readme",
  "bugs": {
    "url": "https://github.com/pausanchez/ui_calling/issues"
  },
  "keywords": [
    "ui-calling",
    "hono",
    "agents",
    "ui"
  ],
  "type": "module",
  "exports": {
    ".": {
      "ui-calling-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "tsup": {
    "entry": {
      "index": "src/index.ts"
    },
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true,
    "sourcemap": true,
    "target": "es2022",
    "removeNodeProtocol": false
  },
  "dependencies": {
    "@ui-calling/core": "^0.0.1",
    "hono": "^4.13.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
