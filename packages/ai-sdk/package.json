{
  "name": "@ui-calling/ai-sdk",
  "version": "0.0.1",
  "description": "Use UI_calling surfaces as tools with the Vercel AI SDK.",
  "type": "module",
  "exports": {
    ".": {
      "ui-calling-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "tsup": {
    "entry": {
      "index": "src/index.ts"
    },
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true,
    "sourcemap": true,
    "target": "es2022",
    "removeNodeProtocol": false
  },
  "dependencies": {
    "@ui-calling/core": "^0.0.1"
  },
  "peerDependencies": {
    "ai": ">=6.0.0"
  },
  "devDependencies": {
    "ai": "^7.0.181"
  }
}
