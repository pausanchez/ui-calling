{
  "name": "@ui-calling/react",
  "version": "0.0.1",
  "description": "React bindings for UI_calling surfaces: typed data, semantic events, automatic lifecycle tracking.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pausanchez/ui_calling.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/pausanchez/ui_calling#readme",
  "bugs": {
    "url": "https://github.com/pausanchez/ui_calling/issues"
  },
  "keywords": [
    "ui-calling",
    "react",
    "agents",
    "ui"
  ],
  "type": "module",
  "exports": {
    ".": {
      "ui-calling-source": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "tsup": {
    "entry": {
      "index": "src/index.tsx"
    },
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true,
    "sourcemap": true,
    "target": "es2022",
    "banner": {
      "js": "\"use client\";"
    },
    "removeNodeProtocol": false
  },
  "dependencies": {
    "@ui-calling/core": "^0.0.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
