{
  "name": "@ui-calling/openai",
  "version": "0.1.0-preview.1",
  "description": "Use ui-calling surfaces as function tools with OpenAI's Responses or Chat Completions API. No SDK dependency.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pausanchez/ui-calling.git",
    "directory": "packages/openai"
  },
  "homepage": "https://github.com/pausanchez/ui-calling#readme",
  "bugs": {
    "url": "https://github.com/pausanchez/ui-calling/issues"
  },
  "keywords": [
    "ui-calling",
    "openai",
    "tools"
  ],
  "type": "module",
  "exports": {
    ".": {
      "ui-calling-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "tsup": {
    "entry": {
      "index": "src/index.ts"
    },
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true,
    "sourcemap": true,
    "target": "es2022",
    "removeNodeProtocol": false
  },
  "dependencies": {
    "@ui-calling/core": "^0.1.0-preview.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
